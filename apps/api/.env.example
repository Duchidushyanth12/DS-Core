# ─────────────────────────────────────────────
# DS-corE API — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.

NODE_ENV=production
PORT=4000

# Prisma / PostgreSQL connection string
# Get this from your Render Postgres dashboard or Neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# URL where the Execution Engine service is running
EXECUTION_ENGINE_URL=https://dsc-execution-engine.onrender.com

# Comma-separated list of allowed CORS origins
# e.g. your Vercel frontend URL
ALLOWED_ORIGIN=https://ds-core.vercel.app

# Firebase Admin SDK (optional — for real auth in production)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@email.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
